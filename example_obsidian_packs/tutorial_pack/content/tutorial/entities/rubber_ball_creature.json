{
  "description": {
    "name": "Rubber Ball Creature",
    "spawnable": true,
    "summonable": true,
    "vanilla_entity_type": "minecraft:slime",
    "spawn_egg": {
      "base_color": "#3C3C3C",
      "overlay_color": "#F2B705"
    }
  },
  "entity_components": {
    "entity_category": "creature"
  },
  "properties": {
    "size": {
      "type": "enum",
      "enum_values": ["small", "medium"],
      "default": "small",
      "client_sync": true
    },
    "has_block": {
      "type": "boolean",
      "default": false,
      "client_sync": true
    },
    "targeting": {
      "type": "boolean",
      "default": false,
      "client_sync": true
    },
    "archetype": {
      "type": "enum",
      "enum_values": ["none", "rubber_ball", "football", "sticky"],
      "default": "rubber_ball",
      "client_sync": true
    },
    "can_pickup": {
      "type": "boolean",
      "default": true
    }
  },
  "components": {
    "minecraft:collision_box": {
      "width": 0.7,
      "height": 0.7
    },
    "minecraft:health": {
      "max": 20.0,
      "value": 20.0
    },
    "minecraft:movement": {
      "value": 0.24
    },
    "minecraft:movement.basic": {},
    "minecraft:behavior.random_stroll": {
      "priority": 4,
      "speed_multiplier": 1.0
    },
    "minecraft:behavior.random_look_around": {
      "priority": 5
    },
    "minecraft:behavior.look_at_player": {
      "priority": 6,
      "look_distance": 6.0,
      "probability": 0.05
    }
  },
  "component_sets": {
    "size_small": {
      "components": {
        "minecraft:collision_box": {
          "width": 0.6,
          "height": 0.6
        },
        "minecraft:movement": {
          "value": 0.28
        }
      }
    },
    "size_medium": {
      "components": {
        "minecraft:collision_box": {
          "width": 0.8,
          "height": 0.8
        },
        "minecraft:movement": {
          "value": 0.22
        }
      }
    },
    "with_block": {
      "components": {
        "minecraft:health": {
          "max": 30.0,
          "value": 30.0
        },
        "minecraft:behavior.panic": {
          "priority": 2,
          "speed_multiplier": 1.25
        }
      }
    },
    "without_block": {
      "components": {
        "minecraft:health": {
          "max": 20.0,
          "value": 20.0
        }
      }
    },
    "archetype_rubber_ball": {
      "components": {
        "minecraft:movement": {
          "value": 0.29
        }
      }
    },
    "archetype_football": {
      "components": {
        "minecraft:movement": {
          "value": 0.24
        }
      }
    },
    "archetype_sticky": {
      "components": {
        "minecraft:movement": {
          "value": 0.16
        }
      }
    }
  },
  "states": [
    {
      "name": "size_small_state",
      "property": "size",
      "equals": "small",
      "apply": ["size_small"]
    },
    {
      "name": "size_medium_state",
      "property": "size",
      "equals": "medium",
      "apply": ["size_medium"]
    },
    {
      "name": "with_block_state",
      "property": "has_block",
      "equals": true,
      "apply": ["with_block"]
    },
    {
      "name": "without_block_state",
      "property": "has_block",
      "equals": false,
      "apply": ["without_block"]
    },
    {
      "name": "rubber_ball_state",
      "property": "archetype",
      "equals": "rubber_ball",
      "apply": ["archetype_rubber_ball"]
    },
    {
      "name": "football_state",
      "property": "archetype",
      "equals": "football",
      "apply": ["archetype_football"]
    },
    {
      "name": "sticky_state",
      "property": "archetype",
      "equals": "sticky",
      "apply": ["archetype_sticky"]
    }
  ],
  "predicates": {
    "can_pickup_now": {
      "property": "can_pickup",
      "value": true
    },
    "currently_holding_block": {
      "property": "has_block",
      "value": true
    },
    "currently_not_holding_block": {
      "property": "has_block",
      "value": false
    }
  },
  "timers": {
    "pickup_cooldown": {
      "duration_ticks": 80,
      "on_complete_event": "pickup_ready",
      "loop": false
    }
  },
  "events": {
    "pickup_block": {
      "actions": [
        {
          "type": "if",
          "predicate": "can_pickup_now",
          "then": [
            {
              "type": "sequence",
              "actions": [
                {
                  "type": "set_property",
                  "property": "has_block",
                  "value": true
                },
                {
                  "type": "set_property",
                  "property": "can_pickup",
                  "value": false
                },
                {
                  "type": "start_timer",
                  "timer": "pickup_cooldown"
                }
              ]
            }
          ]
        }
      ]
    },
    "drop_block": {
      "actions": [
        {
          "type": "if",
          "predicate": "currently_holding_block",
          "then": [
            {
              "type": "set_property",
              "property": "has_block",
              "value": false
            }
          ]
        }
      ]
    },
    "pickup_ready": {
      "actions": [
        {
          "type": "set_property",
          "property": "can_pickup",
          "value": true
        }
      ]
    },
    "become_football_or_sticky": {
      "actions": [
        {
          "type": "random_choice",
          "choices": [
            {
              "weight": 3,
              "actions": [
                {
                  "type": "set_property",
                  "property": "archetype",
                  "value": "football"
                }
              ]
            },
            {
              "weight": 1,
              "actions": [
                {
                  "type": "set_property",
                  "property": "archetype",
                  "value": "sticky"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "interactions": [
    {
      "id": "pickup",
      "display_text": "Pick Up Block",
      "predicate": "can_pickup_now",
      "actions": [
        {
          "type": "trigger_event",
          "event": "pickup_block"
        }
      ],
      "sound": "minecraft:entity.item.pickup",
      "item_damage": 1
    },
    {
      "id": "drop",
      "display_text": "Drop Block",
      "predicate": "currently_holding_block",
      "actions": [
        {
          "type": "trigger_event",
          "event": "drop_block"
        }
      ],
      "sound": "minecraft:block.wool.break"
    }
  ],
  "ai": {
    "goal_selector": {
      "backend": "goal_selector",
      "goals": [
        {
          "id": "minecraft:behavior.random_look_around",
          "priority": 5
        },
        {
          "id": "minecraft:behavior.look_at_player",
          "priority": 6
        },
        {
          "id": "minecraft:behavior.panic",
          "priority": 2
        }
      ],
      "targets": []
    },
    "brain": {
      "backend": "brain",
      "sensors": [],
      "activities": [],
      "memories": []
    }
  }
}
